rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function memberPath(o) { return /databases/$(database)/documents/orgs/$(o)/members/$(request.auth.uid); }
    function mem(o) { return signedIn() && exists(memberPath(o)); }
    function admin(o) { return mem(o) && get(memberPath(o)).data.role == 'admin'; }
    function legacyAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/org/main)
        && get(/databases/$(database)/documents/org/main).data.admin == request.auth.uid;
    }

    // Per-user index: which organisations I belong to.
    match /users/{u} {
      allow read: if signedIn() && (u == request.auth.uid || legacyAdmin());
      allow write: if signedIn() && u == request.auth.uid;
    }

    // Invitations by e-mail (lower case); each names the organisation it is for.
    match /invites/{email} {
      allow read: if signedIn() && (email == myEmail() || legacyAdmin()
        || (resource.data.orgId is string && admin(resource.data.orgId)));
      allow create, update: if signedIn() && (admin(request.resource.data.orgId) || legacyAdmin());
      allow delete: if signedIn() && (email == myEmail() || admin(resource.data.orgId));
    }

    match /orgs/{o} {
      allow read: if mem(o);
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if admin(o);

      match /members/{m} {
        allow read: if mem(o);
        allow create: if admin(o) || (signedIn() && m == request.auth.uid && (
          (get(/databases/$(database)/documents/orgs/$(o)).data.owner == request.auth.uid
            && request.resource.data.role == 'admin') ||
          (exists(/databases/$(database)/documents/invites/$(myEmail()))
            && get(/databases/$(database)/documents/invites/$(myEmail())).data.orgId == o
            && request.resource.data.role == get(/databases/$(database)/documents/invites/$(myEmail())).data.role)));
        allow update, delete: if admin(o);
      }

      match /tickets/{id} {
        allow read: if admin(o) || (mem(o) && resource.data.assigneeUid == request.auth.uid);
        allow create: if mem(o) && request.resource.data.updatedBy == request.auth.uid
          && (admin(o) || request.resource.data.assigneeUid == request.auth.uid);
        allow update: if admin(o) || (mem(o) && resource.data.assigneeUid == request.auth.uid
          && request.resource.data.assigneeUid == request.auth.uid);
        allow delete: if admin(o);
        match /notes/{n} {
          function mine() { return get(/databases/$(database)/documents/orgs/$(o)/tickets/$(id)).data.assigneeUid == request.auth.uid; }
          allow read: if admin(o) || (mem(o) && mine());
          allow create: if mem(o) && (request.resource.data.by == request.auth.uid || admin(o)) && (admin(o) || mine());
        }
      }

      // Team map: latest location only; written by the technician himself, read by managers.
      match /locations/{u} {
        allow read: if admin(o) || (mem(o) && u == request.auth.uid);
        allow write: if mem(o) && u == request.auth.uid;
      }

      match /tasks/{id} {
        allow read: if admin(o) || (mem(o) && resource.data.assigneeUid == request.auth.uid);
        allow create: if mem(o) && request.resource.data.updatedBy == request.auth.uid
          && (admin(o) || request.resource.data.assigneeUid == request.auth.uid);
        allow update: if admin(o) || (mem(o) && resource.data.assigneeUid == request.auth.uid
          && request.resource.data.assigneeUid == request.auth.uid);
        allow delete: if admin(o);
      }
    }

    // Public pages (link with an unguessable token): ticket status, quote approval, client QR.
    // Readable one-by-one only (no listing). Ticket pages are written by the server.
    match /public/{k} {
      allow get: if true;
      allow list: if signedIn() && resource.data.by == request.auth.uid;
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && request.resource.data.type in ['quote', 'client'] && mem(request.resource.data.org);
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
      allow update: if (signedIn() && resource.data.by == request.auth.uid && request.resource.data.by == request.auth.uid)
        || (resource.data.type == 'quote' && resource.data.status == 'Sent'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'answeredAt'])
            && request.resource.data.status in ['Approved', 'Rejected']
            && request.resource.data.reply is string && request.resource.data.reply.size() < 500
            && request.resource.data.answeredAt is number);
    }
    // A client's problem report from the QR page; the server turns it into a ticket.
    match /requests/{r} {
      allow create: if request.resource.data.keys().hasOnly(['k', 'text', 'name', 'phone', 'at'])
        && request.resource.data.k is string && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() < 1000
        && request.resource.data.get('name', '').size() < 80 && request.resource.data.get('phone', '').size() < 30
        && exists(/databases/$(database)/documents/public/$(request.resource.data.k))
        && get(/databases/$(database)/documents/public/$(request.resource.data.k)).data.type == 'client';
    }

    // Old single-team data: readable by its manager only, for the one-time move into orgs/beki.
    match /org/main {
      allow read: if signedIn();
      allow update: if legacyAdmin();
    }
    match /tickets/{id} {
      allow read, delete: if legacyAdmin();
      match /notes/{n} { allow read: if legacyAdmin(); }
    }
    match /tasks/{id} { allow read, delete: if legacyAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
